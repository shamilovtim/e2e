+
+test('snapshot-derived gesture bounds refuse unknown origin before input', async () => {
+  const calls: string[] = [];
+  const device = createInteractionDevice(geometrySnapshot('derived'), {
+    performGesture: async () => {
+      calls.push('gesture');
