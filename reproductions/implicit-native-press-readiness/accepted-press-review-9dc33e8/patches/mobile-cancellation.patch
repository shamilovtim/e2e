+  const budget = new InputBudget(command, 100, (pending) => pending, new AbortController().signal);
+  try {
+    if (command === 'press') {
+      await expect(budget.send((signal) => client.interactions.press({ x: 20, y: 20, signal }))).resolves.toBeDefined();
