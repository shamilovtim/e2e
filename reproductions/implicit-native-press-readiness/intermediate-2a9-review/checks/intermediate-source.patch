+            ),
+            { snapshotInteractiveOnly: true },
+          )
+        : buildSnapshotState(
+            {
+              ...presentIosRunnerSnapshot(
+                {
+                  stage: 'presented',
+                  presentation: {
+                    producer,
+                    intent: 'full',
+                    payload: {
+                      nodes: rawNodes.map((node) => ({
