+// Diagnostic only: never add the optional attribute to the required snapshot vocabulary.
+- (void)recordAbsoluteValueProbeForSnapshot:(NSDictionary *)snapshot node:(NSDictionary *)node
+{
+  NSString *identifier = node[kAttributeIdentifier];
+  NSNumber *type = node[kAttributeAutomationType];
+  if (![identifier isKindOfClass:NSString.class] || ![@[@"geometry-input", @"native-field"] containsObject:identifier] ||
+      ![type isKindOfClass:NSNumber.class] || type.unsignedIntegerValue != 49) return;
+  NSMutableDictionary *row = [@{
+    @"identifier": identifier,
+    @"guestValue": node[kAttributeValue] ?: NSNull.null,
+    @"placeholder": node[kAttributePlaceholderValue] ?: NSNull.null,
+  } mutableCopy];
+  @try {
+    NSArray *numbers = _attributeNumbersForNames(@[@"XC_kAXXCAttributeAbsoluteValue"]);
+    BOOL supported = [numbers isKindOfClass:NSArray.class] && numbers.count == 1 &&
+        [numbers.firstObject isKindOfClass:NSNumber.class];
+    row[@"vocabularySupported"] = @(supported);
+    id element = snapshot[kSnapshotElement];
+    row[@"sameSnapshotElementPresent"] = @(element != nil);
+    if (supported && element) {
+      NSMutableDictionary *options = [_defaultSnapshotParameters() mutableCopy] ?: [NSMutableDictionary dictionary];
+      options[@"attributes"] = numbers;
+      options[@"maxDepth"] = @0;
+      options[@"maxChildren"] = @0;
+      options[@"maxArrayCount"] = @0;
+      NSError *failure = nil;
+      NSDictionary *read = [_framework userTestingSnapshotForElement:element options:options error:&failure];
+      NSDictionary *attributes = [read isKindOfClass:NSDictionary.class] ? read[kSnapshotAttributes] : nil;
+      id value = [attributes isKindOfClass:NSDictionary.class] ? attributes[numbers.firstObject] : nil;
+      row[@"readSucceeded"] = @([attributes isKindOfClass:NSDictionary.class] && failure == nil);
+      row[@"attributePresent"] = @(value != nil);
+      if (failure) row[@"nativeErrorCode"] = @(failure.code);
+      if (value) row[@"valueClass"] = NSStringFromClass([value class]);
+      if ([value isKindOfClass:NSString.class] || [value isKindOfClass:NSNumber.class]) row[@"absoluteValue"] = value;
+    }
+  } @catch (NSException *exception) {
+    row[@"probeException"] = exception.name;
+  }
+  NSData *data = [NSJSONSerialization dataWithJSONObject:row options:NSJSONWritingSortedKeys error:NULL];
+  if (data) {
+    NSString *line = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
+    fprintf(stderr, "AGENT_DEVICE_ABSOLUTE_VALUE_PROBE %s\n", line.UTF8String);
+  }
+}
