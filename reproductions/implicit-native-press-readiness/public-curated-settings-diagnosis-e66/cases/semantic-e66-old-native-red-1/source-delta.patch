 #if os(iOS)
+  @MainActor
+  func testReadinessRefusesAReplacementAnonymousCellWithADifferentSynthesizedLabel() throws {
+    app.launchArguments = ["--agent-device-derived-label"]
+    app.launch()
+    defer { app.terminate() }
+    let action = app.buttons["derived-label-action"]
+    XCTAssertTrue(action.waitForFixtureExistence(timeout: appExistenceTimeout))
+    let cell = app.cells.firstMatch
+    let original = try cell.snapshot()
+    XCTAssertTrue(original.label.isEmpty, "fixture must expose an anonymous native container")
+    XCTAssertTrue(original.identifier.isEmpty)
+    let evaluation = evaluateSnapshot(original)
+    XCTAssertEqual(evaluation.label, "Original row")
+    let target = try XCTUnwrap(makeSnapshotNode(snapshot: original, evaluation: evaluation,
+      depth: 1, index: 1, parentIndex: 0).nativePressTarget)
+    XCTAssertEqual(try queryAuthorizedPressTarget(app: app, target: target).data?.pressReadiness, "ready")
+    app.buttons["replace-derived-label"].tap()
+    XCTAssertEqual(action.label, "Replacement row")
+    let replacement = try cell.snapshot()
+    XCTAssertEqual(replacement.frame, original.frame)
+    XCTAssertEqual(replacement.label, original.label)
+    XCTAssertEqual(replacement.identifier, original.identifier)
+    XCTAssertTrue(cell.isHittable)
+    XCTAssertEqual(try queryAuthorizedPressTarget(app: app, target: target).data?.pressReadiness, "missing")
+    XCTAssertEqual(app.staticTexts["agent-device-tap-witness-presses"].label, "presses=0")
+  }
